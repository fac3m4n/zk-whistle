# Template for Hardhat environment variables.

# To use this template, copy this file, rename it .env, and fill in the values.

# If not set, we provide default values (check `hardhat.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this .env file you can use: process.env.VARIABLENAME
ALCHEMY_API_KEY=
ETHERSCAN_V2_API_KEY=

# Optional: override the Base Sepolia RPC endpoint (recommended for reliable deploys).
# The default public RPC is rate-limited and causes nonce errors on multi-tx deploys.
# Use your own Alchemy/Infura/QuickNode URL, e.g.
#   https://base-sepolia.g.alchemy.com/v2/<your-key>
BASE_SEPOLIA_RPC_URL=

# Don't fill this value manually, run yarn generate to generate a new account or yarn account:import to import an existing PK.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Optional: address of the deployed Reclaim verifier for the target live network.
# When set, the WhistleblowerRegistry deploy wires it via setReclaimVerifier so
# submitVerifiedProof() performs trustless on-chain proof verification. On local
# Hardhat a MockReclaim is deployed and used automatically (ignore this).
# See https://docs.reclaimprotocol.org for per-chain verifier addresses.
RECLAIM_VERIFIER_ADDRESS=
